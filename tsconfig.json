{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "allowJs": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "test/**/*.ts", "*.ts"]
}